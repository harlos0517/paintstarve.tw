.git

# Real student roster data - must never end up in an image layer.
data/

node_modules
**/node_modules

# Bare patterns only match at the build context root, not recursively into
# backend/frontend - confirmed the hard way (these leaked into a prod image).
**/.env
**/.env.*
!**/.env.example

# Regenerated inside the image - platform-specific, don't copy from host.
backend/generated/prisma

*.log
.DS_Store

Dockerfile
docker-compose.yml
